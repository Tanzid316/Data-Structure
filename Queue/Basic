#include<bits/stdc++.h>
using namespace std;
int main()
{
    queue<int>q;

    q.push(10);
    q.push(23);
    q.push(7);
    q.push(21);

    cout<<"Size : "<<q.size()<<endl;

    q.pop();

    while(!q.empty())
    {
        cout<<q.front()<<" ";
        q.pop();
    }

    cout<<"\nSize : "<<q.size()<<endl;
    return 0;
}
