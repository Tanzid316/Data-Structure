#include <bits/stdc++.h>
using namespace std;

void BFS(vector<vector<int>>& G, int start)
//outer vector=vertex and inner vector=neighbors
{
    // marked = [False] * G.size()
    vector<bool> marked(G.size(), false);

    // queue = [start]
    queue<int> q;
    q.push(start);

    // while queue is not empty
    while (!q.empty())
    {
        // take the first vertex from queue
        int v = q.front();
        q.pop();

        // if vertex is not visited
        if (!marked[v])
        {
            // visit the vertex
            cout << v << " ";

            // mark it visited
            marked[v] = true;

            // check all neighbours of v
            for (int i = 0; i < G[v].size(); i++)
            {
                int w = G[v][i];

                if (!marked[w])
                {
                    q.push(w);
                }
            }
        }
    }
}

int main()
{
    vector<vector<int>> G =
    {
        {1, 3, 2},    // neighbours of 0
        {0, 3},       // neighbours of 1
        {0, 3},       // neighbours of 2
        {0, 1, 2, 4}, // neighbours of 3
        {3}           // neighbours of 4
    };

    BFS(G, 0);

    return 0;
}
