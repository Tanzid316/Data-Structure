#include<bits/stdc++.h>
using namespace std;

void BFS(vector<vector<int>>&graph,int v)
{
    vector<bool> marked (graph.size(),false);
    queue<int>q;
    q.push(v);
    while(!q.empty())
    {
        v = q.front();
        q.pop();
        if(!marked[v])
        {
            cout<<v<<" ";
            marked[v] = true;
            for(int w : graph[v])
            {
                if(!marked[w])
                {
                    q.push(w);
                }
            }
        }
    }
}

int main()
{
    vector<vector<int>>graph{
        {1,2,3},
        {0,3},
        {0,3},
        {0,1,2,4},
        {3}
    };
    BFS(graph,0); //graph and starting vertex.
    return 0;
}
