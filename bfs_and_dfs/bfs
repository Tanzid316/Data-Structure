//BFS
/*
Here is the algorithm and graph image : 
https://imgur.com/Qy07m8F

Algorithm                         C++

marked = [False] * G.size()   →   vector<bool> marked(G.size(), false);

queue = [v]                   →   queue<int> q;
                                  q.push(v);

while len(queue) > 0          →   while (!q.empty())

v = queue.pop()               →   v = q.front();
                                  q.pop();

if not marked[v]              →   if (!marked[v])

visit(v)                      →   cout << v << " ";

marked[v] = True              →   marked[v] = true;

for w in G.neighbors(v)       →   for (int w : G[v])

if not marked[w]              →   if (!marked[w])

queue.append(w)               →   q.push(w);


*/
#include<bits/stdc++.h>
using namespace std;

void BFS(vector<vector<int>>&graph,int v)
{
    vector<bool> marked (graph.size(),false);
    queue<int>q;
    q.push(v);
    while(!q.empty())
    {
        v = q.front();
        q.pop();
        if(!marked[v])
        {
            cout<<v<<" ";
            marked[v] = true;
            for(int w : graph[v])
            {
                if(!marked[w])
                {
                    q.push(w);
                }
            }
        }
    }
}

int main()
{
    vector<vector<int>>graph{
        {1,2,3},
        {0,3},
        {0,3},
        {0,1,2,4},
        {3}
    };
    BFS(graph,0); //graph and starting vertex.
    return 0;
}
