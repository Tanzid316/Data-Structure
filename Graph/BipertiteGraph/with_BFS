#include <bits/stdc++.h>
using namespace std;

bool isBipartite(vector<vector<int>>& graph)
{
    int n = graph.size();
    vector<int> color(n, -1);
    queue<int> q;

    for(int s = 0; s < n; s++)
    {
        if(color[s] == -1)
        {
            color[s] = 0;
            q.push(s);

            while(!q.empty())
            {
                int v = q.front();
                q.pop();

                for(int w : graph[v])
                {
                    if(color[w] == -1)
                    {
                        color[w] = 1 - color[v];
                        q.push(w);
                    }
                    else if(color[w] == color[v])
                    {
                        return false;   // Conflict found
                    }
                }
            }
        }
    }
    return true;
}

int main()
{
    vector<vector<int>> graph{
        {1},        // 0
        {0, 2},     // 1
        {1, 3, 7},  // 2
        {2, 4},     // 3
        {3, 5},     // 4
        {6, 4},     // 5
        {7, 5},     // 6
        {2, 6}      // 7
    };

    if(isBipartite(graph))
        cout << "Yes. Bipartite graph" << endl;
    else
        cout << "No. Not a Bipartite graph" << endl;

    return 0;
}
