#include<bits/stdc++.h>
using namespace std;
stack<int> s;
int main()
{
    string postfix;
    cin>>postfix;
    for(int i = 0; i<postfix.size();i++)
    {
        char c = postfix[i];
        if(c >= '0' && c <= '9')
        {
            s.push(c - '0');
        }
        else{
            int a = s.top();
            s.pop();
            int b = s.top();
            s.pop();
            int res;
            if(c == '+') res = b + a;
            else if(c == '-') res = b - a;
            else if(c == '*') res = b * a;
            else if(c == '/') res = b / a;
            else if(c == '^') res = pow(b,a);
            else{
                cout<<"Invalid Operator."<<endl;
            }

            s.push(res);
        }
    }
    cout << s.top() << endl;
}
